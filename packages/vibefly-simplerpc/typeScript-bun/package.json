{
  "name": "@sandogeek/simple-rpc-bun",
  "version": "0.0.1",
  "description": "Bun/Node SimpleRpc transports: stdio Content-Length framing and ServerWebSocket hello handshake",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "bun test ./test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@sandogeek/simple-rpc": "file:../typeScript"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.0"
  },
  "license": "UNLICENSED",
  "private": true
}
