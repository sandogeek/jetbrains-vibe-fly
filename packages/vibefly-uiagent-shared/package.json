{
  "name": "@vibefly/uiagent-shared",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Shared UI ↔ Agent SimpleRpc contracts (TypeScript-only, no Kotlin)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agent": {
      "types": "./dist/agent-settings.d.ts",
      "import": "./dist/agent-settings.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "node ./scripts/generate-rpc-contracts.mjs",
    "generate:check": "node ./scripts/generate-rpc-contracts.mjs --check",
    "test": "pnpm run generate:check && node --import tsx --test 'test/**/*.test.ts'",
    "typecheck": "pnpm run generate:check && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@sandogeek/simple-rpc": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  },
  "license": "UNLICENSED"
}
