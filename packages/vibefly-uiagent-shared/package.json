{
  "name": "@vibefly/uiagent-shared",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Shared UI ↔ Agent SimpleRpc contracts (TypeScript-only, no Kotlin)",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "generate": "node ./scripts/generate-rpc-contracts.mjs",
    "generate:check": "node ./scripts/generate-rpc-contracts.mjs --check",
    "test": "npm run generate:check && node --import tsx --test 'test/**/*.test.ts'",
    "typecheck": "npm run generate:check && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@sandogeek/simple-rpc": "file:../vibefly-simplerpc/typeScript"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  },
  "license": "UNLICENSED"
}
