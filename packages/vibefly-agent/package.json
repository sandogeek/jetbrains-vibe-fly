{
  "name": "@vibefly/agent",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Vibe Fly Node agent: Oh My Pi (omp) engine bridged to JVM via SimpleRpc over stdio",
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    }
  },
  "bin": {
    "vibefly-agent": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "start": "tsx src/main.ts",
    "start:dist": "node dist/main.js",
    "export:catalog": "tsx scripts/export-bundled-catalog.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@oh-my-pi/pi-ai": "17.0.6",
    "@oh-my-pi/pi-catalog": "17.0.6",
    "@oh-my-pi/pi-coding-agent": "17.0.6",
    "@sandogeek/simple-rpc": "file:../vibefly-simplerpc/typeScript",
    "@sandogeek/simple-rpc-node": "file:../vibefly-simplerpc/typeScript-node",
    "@vibefly/uiagent-shared": "file:../vibefly-uiagent-shared",
    "jsonc-parser": "^3.3.1",
    "winston": "^3.17.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "expect": "^29.7.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED"
}
