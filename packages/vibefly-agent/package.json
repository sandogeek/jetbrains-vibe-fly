{
  "name": "@vibefly/agent",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Vibe Fly Node agent: pi engine bridged to JVM via SimpleRpc over stdio",
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    }
  },
  "bin": {
    "vibefly-agent": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "pnpm -C ../vibefly-uiagent-shared run build",
    "pretypecheck": "pnpm -C ../vibefly-uiagent-shared run build",
    "pretest": "pnpm -C ../vibefly-uiagent-shared run build",
    "prestart": "pnpm -C ../vibefly-uiagent-shared run build",
    "prestart:dist": "pnpm -C ../vibefly-uiagent-shared run build",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "start": "tsx src/main.ts",
    "start:dist": "node dist/main.js",
    "export:catalog": "tsx scripts/export-bundled-catalog.ts",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.83.0",
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@sandogeek/simple-rpc": "workspace:*",
    "@sandogeek/simple-rpc-node": "workspace:*",
    "@vibefly/uiagent-shared": "workspace:*",
    "jsonc-parser": "^3.3.1",
    "proper-lockfile": "4.1.2",
    "winston": "^3.17.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "expect": "^29.7.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED"
}
