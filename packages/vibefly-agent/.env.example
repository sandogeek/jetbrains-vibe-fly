# Commit message generation (Host2Agent → pi-ai complete).
# Copy to .env and fill in. Bun loads this when cwd is packages/vibefly-agent
# (plugin ProcessBuilder already uses that directory).

# Required: provider/modelId (catalog id or custom)
# Examples: openai/gpt-4o-mini  |  openai/gpt-5.4-mini
VIBEFLY_COMMIT_MODEL=openai/gpt-4o-mini

# Wire API for custom / OpenAI-compatible gateways (default openai-responses)
# Use openai-completions for most third-party /v1 chat APIs
VIBEFLY_COMMIT_API=openai-completions

# Custom endpoint (or OPENAI_BASE_URL)
VIBEFLY_COMMIT_BASE_URL=https://www.packyapi.com/v1

# API key (or OPENAI_API_KEY / provider-specific env from pi-ai)
VIBEFLY_COMMIT_API_KEY=

# Optional: zh | en (default en)
# VIBEFLY_COMMIT_LANGUAGE=en

# Optional: log full LLM context (system + user prompt) to stderr
# VIBEFLY_COMMIT_DEBUG=1
# VIBEFLY_DEBUG=1
