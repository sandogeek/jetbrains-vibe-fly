{
  "name": "@vibefly/ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Vibe Fly WebView UI (Vite + SolidJS + SolidUI + Tailwind CSS v4), served via http://vibefly/",
  "scripts": {
    "predev": "npm --prefix ../vibefly-uiagent-shared run build",
    "prebuild": "npm --prefix ../vibefly-uiagent-shared run build",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "pretypecheck": "npm --prefix ../vibefly-uiagent-shared run build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.11",
    "@sandogeek/simple-rpc": "file:../vibefly-simplerpc/typeScript",
    "@solid-primitives/i18n": "^2.2.1",
    "@solidjs/router": "0.15.3",
    "@vibefly/uiagent-shared": "file:../vibefly-uiagent-shared",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.12",
    "loglevel": "^1.9.2",
    "lucide-solid": "^1.27.0",
    "marked": "^18.0.7",
    "solid-js": "^1.9.9",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/dompurify": "^3.2.0",
    "expect": "^29.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-solid": "^2.11.6"
  }
}
