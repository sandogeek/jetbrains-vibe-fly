{
  "name": "@vibefly/ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Vibe Fly WebView UI (Vite + React + assistant-ui + Streamdown + Tailwind CSS v4), served via http://vibefly/",
  "scripts": {
    "predev": "pnpm -C ../vibefly-uiagent-shared run build",
    "prebuild": "pnpm -C ../vibefly-uiagent-shared run build",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "pretypecheck": "pnpm -C ../vibefly-uiagent-shared run build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.4",
    "@assistant-ui/react-streamdown": "^0.3.8",
    "@sandogeek/simple-rpc": "workspace:*",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@vibefly/uiagent-shared": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.1",
    "loglevel": "^1.9.2",
    "lucide-react": "^1.28.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.2",
    "remark-breaks": "^4.0.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.13.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "expect": "^29.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
