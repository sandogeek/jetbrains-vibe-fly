{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug vibefly-agent",
      "program": "${workspaceFolder}/packages/vibefly-agent/src/main.ts",
      "runtimeArgs": ["--import", "tsx"],
      "cwd": "${workspaceFolder}/packages/vibefly-agent",
      "stopOnEntry": false,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug vibefly-agent (stop on entry)",
      "program": "${workspaceFolder}/packages/vibefly-agent/src/main.ts",
      "runtimeArgs": ["--import", "tsx"],
      "cwd": "${workspaceFolder}/packages/vibefly-agent",
      "stopOnEntry": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Attach vibefly-agent",
      "port": 6499,
      "restart": false,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
