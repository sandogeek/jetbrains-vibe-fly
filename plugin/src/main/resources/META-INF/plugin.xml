<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.sandogeek.jetbrainsvibefly</id>
    <name>Vibe Fly</name>
    <vendor>sandogeek</vendor>
    <description><![CDATA[
        <p><b>Vibe Fly</b> is a repository that provides a pure template to make it easier to create a new plugin project.</p>
        <p>The main goal of this template is to speed up the setup phase of plugin development for both new and experienced developers by preconfiguring the project scaffold and CI, linking to the proper documentation pages, and keeping everything organized.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.vcs</depends>
    <!-- 2025.3+: module alias when JCEF is bundled. 2026.2+: separate plugin that must
         be a PluginClassLoader parent for JBCefBrowser. Optional so 2025.2 (252) can load
         (JCEF is on the platform classpath there without this id). -->
    <depends optional="true">com.intellij.modules.jcef</depends>


    <resource-bundle>messages.VibeflyBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow factoryClass="com.github.sandogeek.jetbrainsvibefly.toolWindow.VibeflyToolWindowFactory" id="Vibe Fly"/>
        <postStartupActivity implementation="com.github.sandogeek.jetbrainsvibefly.startup.MyProjectActivity" />
        <notificationGroup id="Vibe Fly" displayType="BALLOON"/>

        <fileEditorProvider
                implementation="com.github.sandogeek.jetbrainsvibefly.settings.VibeflySettingsFileEditorProvider"/>
        <fileType name="VibeflySettings"
                  implementationClass="com.github.sandogeek.jetbrainsvibefly.settings.VibeflySettingsFileType"
                  fieldName="INSTANCE"/>
    </extensions>

    <actions>
        <action id="VibeFly.GenerateCommitMessage"
                class="com.github.sandogeek.jetbrainsvibefly.commit.GenerateCommitMessageAction"
                icon="AllIcons.Actions.Edit">
            <add-to-group group-id="Vcs.MessageActionGroup" anchor="first"/>
        </action>
        <action id="VibeFly.AddSelectionToChat"
                class="com.github.sandogeek.jetbrainsvibefly.chat.AddSelectionToVibeflyAction"
                text="Add to Vibe Fly"
                description="Add the current editor selection to the active Vibe Fly session">
            <add-to-group group-id="Floating.CodeToolbar" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
